<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion><NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <EnableVendorReconstruction Condition="'$(EnableVendorReconstruction)' == ''">true</EnableVendorReconstruction>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
    <Compile Include="Probe.cs" />
    <Compile Include="ReconstructionProbe.cs" />
    <Compile Include="SceneProbe.cs" />
    <Compile Include="GlassReconstructionProbe.cs" />
    <Compile Include="LightingProbe.cs" />
    <Compile Include="../../DXRDemo/Shaders/ShaderCatalog.cs" />
    <Compile Include="../../DXRDemo/DXR/*.cs" Exclude="../../DXRDemo/DXR/DxrRenderer.cs;../../DXRDemo/DXR/DxrSwapChain.cs" />
    <Compile Include="../../DXRDemo/Shaders/RayTrace/*.cs" />
    <Compile Include="../../DXRDemo/SuperResolution/*.cs" />
    <Compile Include="../../DXRDemo/Camera/*.cs;../../DXRDemo/Scene/*.cs;../../DXRDemo/Assets/Importers/*.cs" />
    <Compile Include="../../DXRDemo/Shaders/IShaderPass.cs;../../DXRDemo/Shaders/ShaderAuthor.cs;../../DXRDemo/Shaders/ShaderCapabilities.cs" />
    <Compile Include="../../DXRDemo/Hdr/IHdrShaderRunner.cs;../../DXRDemo/Hdr/IRenderDiagnostics.cs;../../DXRDemo/Hdr/GpuDiagnostics.cs" />
    <Content Include="../../DXRDemo/Assets/Models/**" Link="Assets/Models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Samples/RainyCorner/RainyCorner.glb" Link="Assets/Models/RainyCorner.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/Reconstruction.hlsl" Link="Shaders/DXR/Reconstruction.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/SceneTrace.hlsl" Link="Shaders/DXR/SceneTrace.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/SceneLighting.hlsli" Link="Shaders/DXR/SceneLighting.hlsli" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../DXRDemo/SuperResolution/ReconstructionAssets.targets" />
</Project>
