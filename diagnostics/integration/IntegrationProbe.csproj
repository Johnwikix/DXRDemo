<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion><NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <EnableVendorReconstruction Condition="'$(EnableVendorReconstruction)' == ''">true</EnableVendorReconstruction>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" Version="1.619.6" />
    <Content Include="$(NuGetPackageRoot)/microsoft.direct3d.d3d12/1.619.6/build/native/bin/x64/*.dll"
             Link="D3D12/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
    <Compile Include="Probe.cs" />
    <Compile Include="ReconstructionProbe.cs" />
    <Compile Include="SceneProbe.cs" />
    <Compile Include="SceneSessionProbe.cs" />
    <Compile Include="HudProbe.cs" />
    <Compile Include="GpuSceneCacheProbe.cs" />
    <Compile Include="RasterProbe.cs" />
    <Compile Include="CommonFrameProbe.cs" />
    <Compile Include="RasterSceneProbe.cs" />
    <Compile Include="GlassReconstructionProbe.cs" />
    <Compile Include="LightingProbe.cs" />
    <Compile Include="OfflineProbe.cs" />
    <Compile Include="NrdMotionProbe.cs" />
    <Compile Include="TemporalConvergenceProbe.cs" />
    <Compile Include="TemporalSceneProbe.cs" />
    <Compile Include="EnvironmentSamplingProbe.cs" />
    <Compile Include="OptixProbe.cs" />
    <Compile Include="SunGlassProbe.cs" />
    <Compile Include="SunShadowProbe.cs" />
    <Compile Include="DenoiserSrProbe.cs" />
    <Compile Include="GlassTemporalProbe.cs" />
    <Compile Include="OfflineFeatureChecks.cs" />
    <Content Include="Shaders/*" Link="Shaders/DXR/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../DXRDemo/Shaders/ShaderCatalog.cs" />
    <Compile Include="../../DXRDemo/DXR/*.cs" />
    <Compile Include="../../DXRDemo/Rendering/*.cs" />
    <Compile Include="../../DXRDemo/Shaders/RayTrace/*.cs" />
    <Compile Include="../../DXRDemo/Shaders/Raster/*.cs" />
    <Compile Include="../../DXRDemo/SuperResolution/*.cs" />
    <Compile Include="../../DXRDemo/Camera/*.cs;../../DXRDemo/Scene/*.cs;../../DXRDemo/Assets/Importers/*.cs" />
    <Compile Include="../../DXRDemo/Shaders/ISceneShaderPass.cs;../../DXRDemo/Shaders/IShaderPass.cs;../../DXRDemo/Shaders/ShaderAuthor.cs;../../DXRDemo/Shaders/ShaderCapabilities.cs" />
    <Compile Include="../../DXRDemo/Hdr/IHdrShaderRunner.cs;../../DXRDemo/Hdr/IRenderDiagnostics.cs;../../DXRDemo/Hdr/GpuDiagnostics.cs" />
    <Content Include="../../DXRDemo/Assets/Models/**" Link="Assets/Models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Samples/RainyCorner/RainyCorner.glb" Link="Assets/Models/RainyCorner.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/FrameEffects.hlsl" Link="Shaders/DXR/FrameEffects.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/Reconstruction.hlsl" Link="Shaders/DXR/Reconstruction.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/DisplayOutput.hlsl;../../DXRDemo/Shaders/DXR/CommonReconstruction.hlsl" Link="Shaders/DXR/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/StableReconstruction.hlsl" Link="Shaders/DXR/StableReconstruction.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/SceneTrace.hlsl" Link="Shaders/DXR/SceneTrace.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/SceneLighting.hlsli" Link="Shaders/DXR/SceneLighting.hlsli" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/Raster.hlsl;../../DXRDemo/Shaders/DXR/SceneTypes.hlsli;../../DXRDemo/Shaders/DXR/SceneEnvironment.hlsli" Link="Shaders/DXR/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/Path*.hlsli" Link="Shaders/DXR/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Shaders/DXR/RTXPT/*.hlsli" Link="Shaders/DXR/RTXPT/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../DXRDemo/Licenses/RTXPT.txt" Link="Licenses/RTXPT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../DXRDemo/SuperResolution/ReconstructionAssets.targets" />
</Project>
