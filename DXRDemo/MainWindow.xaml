<winex:WindowEx
    x:Class="DXRDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx">
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragOver="OnSceneDragOver"
        Drop="OnSceneDrop"
        SizeChanged="OnRootGridSizeChanged">
        <ContentControl
            x:Name="ViewportFocus"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="3D 视口"
            IsTabStop="True"
            KeyDown="OnCameraKeyDown"
            KeyUp="OnCameraKeyUp"
            LostFocus="OnViewportLostFocus"
            SizeChanged="OnRootGridSizeChanged">
            <Canvas x:Name="PanelHost" />
        </ContentControl>
        <StackPanel
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Spacing="8">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="OpenModelButton"
                    Click="OnOpenModel"
                    Content="打开模型">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="O"
                            Invoked="OnOpenModelShortcut"
                            Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <ComboBox
                    x:Name="CameraModeSelector"
                    AutomationProperties.AutomationId="CameraModeSelector"
                    SelectedIndex="0"
                    SelectionChanged="OnCameraModeChanged">
                    <ComboBoxItem Content="轨道相机" />
                    <ComboBoxItem Content="自由相机" />
                </ComboBox>
                <Button
                    AutomationProperties.AutomationId="ViewportResetCameraButton"
                    Click="OnResetCamera"
                    Content="重置镜头" />
                <Button
                    AutomationProperties.AutomationId="OpenSettingsButton"
                    Click="OnOpenSettings"
                    Content="设置"
                    ToolTipService.ToolTip="打开独立设置窗口 (F1)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" Invoked="OnSettingsShortcut" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Name="FullscreenButton"
                    AutomationProperties.AutomationId="ToggleFullscreenButton"
                    Click="OnToggleFullscreen"
                    Content="全屏"
                    ToolTipService.ToolTip="切换全屏 (F11)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" Invoked="OnFullscreenShortcut" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <Button
                x:Name="CancelLoadButton"
                HorizontalAlignment="Right"
                Click="OnCancelLoad"
                Content="取消加载"
                Visibility="Collapsed" />
        </StackPanel>
        <Border
            Grid.Row="1"
            MaxWidth="850"
            Margin="12"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            IsHitTestVisible="False">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="NavigationHint"
                    Text="左键旋转 · 中键平移 · 滚轮缩放 · 拖入 glTF / GLB 打开"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SceneLoadStatus"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</winex:WindowEx>
