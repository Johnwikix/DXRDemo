<winex:WindowEx
    x:Class="DXRDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnRootGridSizeChanged">
        <Canvas x:Name="PanelHost" />
        <Button Content="设置" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Click="OnOpenSettings" AutomationProperties.AutomationId="OpenSettingsButton" ToolTipService.ToolTip="打开独立设置窗口 (F1)">
            <Button.KeyboardAccelerators><KeyboardAccelerator Key="F1" Invoked="OnSettingsShortcut" /></Button.KeyboardAccelerators>
        </Button>
    </Grid>
</winex:WindowEx>
