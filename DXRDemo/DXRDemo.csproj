<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DXRDemo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="1.9.2609.5" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" Version="1.619.6" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Shaders\DXR\**\*.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Shaders\DXR\**\*.hlsli" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <Microsoft_Direct3D_DXC_SkipLibraryCopy>true</Microsoft_Direct3D_DXC_SkipLibraryCopy>
    <_DxcSourceArch Condition="'$(PlatformTarget)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86'">x86</_DxcSourceArch>
    <_DxcSourceArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</_DxcSourceArch>
    <_DxcSourceArch Condition="'$(PlatformTarget)' == 'x64' Or '$(RuntimeIdentifier)' == 'win-x64'">x64</_DxcSourceArch>
    <_DxcSourceDir Condition="'$(_DxcSourceArch)' != ''">$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'microsoft.direct3d.dxc', '1.9.2609.5', 'build', 'native', 'bin', '$(_DxcSourceArch)'))</_DxcSourceDir>
    <_D3d12SourceArch Condition="'$(PlatformTarget)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86'">win32</_D3d12SourceArch>
    <_D3d12SourceArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</_D3d12SourceArch>
    <_D3d12SourceArch Condition="'$(PlatformTarget)' == 'x64' Or '$(RuntimeIdentifier)' == 'win-x64'">x64</_D3d12SourceArch>
    <_D3d12SourceDir Condition="'$(_D3d12SourceArch)' != ''">$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'microsoft.direct3d.d3d12', '1.619.6', 'build', 'native', 'bin', '$(_D3d12SourceArch)'))</_D3d12SourceDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(_DxcSourceArch)' != ''">
    <None Include="$(_DxcSourceDir)\dxc.exe" Link="dxc.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(_DxcSourceDir)\dxcompiler.dll" Link="dxcompiler.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(_DxcSourceDir)\dxil.dll" Link="dxil.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DirectX 12 Agility 1.619 supplies the SM 6.9 runtime. The app activates
       it through ID3D12DeviceFactory and falls back to the inbox runtime when
       the DLL is unavailable or the device does not expose SM 6.9. -->
  <ItemGroup Condition="'$(_D3d12SourceArch)' != ''">
    <None Include="$(_D3d12SourceDir)\D3D12Core.dll" Link="D3D12\D3D12Core.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Models\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Samples\RainyCorner\RainyCorner.glb" Link="Assets\Models\RainyCorner.glb"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <PackageReference Include="WinUIEx" Version="2.9.2" />
  </ItemGroup>
  <Import Project="SuperResolution\ReconstructionAssets.targets" />

  <!-- MrtCore 只把应用 PRI/XBF 写入构建输出（PrepareForRun），其 Publish 钩子仅对 MSIX（AppxPackage=true）生效。
       dotnet publish 解包发布时这些文件不会进入 publish 目录，导致 XAML 启动时 stowed exception (0xc000027b)。 -->
  <Target Name="CopyAppPriAndXbfToPublish" AfterTargets="Publish" Condition="'$(AppxPackage)' != 'true'">
    <ItemGroup>
      <_AppPriAndXbf Include="$(OutDir)$(AssemblyName).pri" />
      <_AppPriAndXbf Include="$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPriAndXbf)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
